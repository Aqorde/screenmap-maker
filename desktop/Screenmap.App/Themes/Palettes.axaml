      <SolidColorBrush x:Key="MenuItemBackgroundPointerOver" Color="{StaticResource PaletteSelection}" />
      <SolidColorBrush x:Key="MenuItemBackgroundSelected" Color="{StaticResource PaletteSelection}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource PaletteFocus}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource PaletteFocus}" />
      <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="{StaticResource PaletteBorder}" />
