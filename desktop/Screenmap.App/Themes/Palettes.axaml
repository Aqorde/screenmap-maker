      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource PaletteText}" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource PaletteText}" />
